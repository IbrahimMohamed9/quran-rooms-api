# ===========================================
# Server Configuration
# ===========================================
PORT=3030
NODE_ENV=development

# ===========================================
# API URLs
# ===========================================
API_BASE_URL=http://localhost:3030/api
FRONTEND_URL=http://localhost:8080

# ===========================================
# Database Configuration (MySQL)
# ===========================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=meetingsnest

# Production Database (commented out by default)
# DB_HOST=your-production-host.com
# DB_PORT=3306
# DB_USER=your_production_user
# DB_PASSWORD=your_production_password
# DB_NAME=your_production_database

# ===========================================
# JWT Authentication
# ===========================================
# Generate a secure secret key (minimum 32 characters recommended)
JWT_SECRET=your_jwt_secret_key_change_this_in_production

# ===========================================
# LiveKit Voice Chat Configuration
# ===========================================
# LiveKit server API credentials
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# LiveKit server WebSocket URL (include wss:// for secure connection)
LIVEKIT_URL=wss://your-livekit-server.com

# Example for local LiveKit server:
# LIVEKIT_URL=ws://localhost:7880

# ===========================================
# IMPORTANT NOTES
# ===========================================
# ⚠️  Configuration Rules:
# - No spaces around the = sign
# - No quotes around values
# - Use wss:// for production LiveKit URLs (secure WebSocket)
# - Use ws:// only for local development LiveKit
# 
# 🔒 Security:
# - Never commit the actual .env file to version control
# - Change all default secrets in production
# - Use strong passwords and secret keys
# 
# 📝 Getting Started:
# 1. Copy this file to .env
# 2. Update all placeholder values
# 3. Set up your database and LiveKit server
# 4. Run database migrations before starting the app
